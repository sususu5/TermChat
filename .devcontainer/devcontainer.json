{
    "name": "TermChat Dev",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "ms-python.python",
                "golang.go",
                "cweijan.vscode-database-client2"
            ],
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.path": "/usr/bin/clangd",
                "cmake.configureArgs": [
                    "-DCMAKE_EXPORT_COMPILE_COMMANDS=1"
                ],
                "clangd.arguments": [
                    "--background-index",
                    "--compile-commands-dir=${workspaceFolder}",
                    "-j=4",
                    "--clang-tidy",
                    "--header-insertion=never",
                    "--completion-style=detailed",
                    "--query-driver=/usr/bin/c++,/usr/bin/g++,/usr/bin/clang++,/usr/bin/clang"
                ],

                "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
                "editor.formatOnSave": true,
                "cmake.configureOnOpen": true,
                "cmake.buildDirectory": "${workspaceFolder}/build/debug",
                "cmake.configureSettings": {
                    "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake"
                },
                
                "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
                "C_Cpp.default.cppStandard": "c++20",
                "terminal.integrated.defaultProfile.linux": "bash",
                "go.useLanguageServer": true,
                "go.lintTool": "golangci-lint",
                "go.formatTool": "gofmt",
                "go.toolsManagement.autoUpdate": true,
                "go.autocompleteUnimportedPackages": true
            }
        }
    },
    "workspaceFolder": "/workspace",
    
    "postCreateCommand": "codex --version && cmake --preset debug && ln -sf build/debug/compile_commands.json compile_commands.json",
    "postStartCommand": "bash .devcontainer/init_scylla.sh",
    "runArgs": [
        "--privileged"
    ],
    "remoteUser": "root",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "enableNonRootDocker": "true",
            "moby": "true"
        }
    }
}
