# Copy to scripts/perf.env on the EC2 host, or run with:
#   PERF_CONFIG=scripts/perf.env.example scripts/run_perf_with_monitor.sh

BENCH_ADDR=127.0.0.1:1316
BENCH_CLIENTS=25000
BENCH_DURATION=240s
BENCH_RATE_PER_CLIENT=0.1
BENCH_RATE_SCHEDULE=poisson
BENCH_CONNECT_RAMP=45s
BENCH_REQUEST_TIMEOUT=30s
BENCH_DRAIN=30s
BENCH_PAYLOAD=256
BENCH_INFLIGHT=1
BENCH_WARMUP=5
BENCH_RECEIVER_MODE=random-online

# Optional. Defaults to benchmark-results/${BENCH_SCENARIO}.
# OUT_DIR=benchmark-results/ec2-25000c-0_1rps

# Optional. Defaults to im_scaling_${BENCH_CLIENTS}c_${BENCH_RATE_PER_CLIENT with . as _}rps_random_ramp${BENCH_CONNECT_RAMP without trailing s}.
# BENCH_SCENARIO=im_scaling_25000c_0_1rps_random_ramp45s
